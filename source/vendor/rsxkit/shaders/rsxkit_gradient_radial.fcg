/* SPDX-License-Identifier: MIT */
void main(float4 uv : TEXCOORD0, float4 mult : TEXCOORD1,
          float4 add : TEXCOORD5, uniform sampler2D tex0 : TEXUNIT0,
          out float4 color : COLOR)
{
    float2 p = uv.xy * 2.0 - 1.0;
    float t = length(p);
    color = saturate(tex2D(tex0, float2(t, 0.5)) * mult + add);
}

