/* SPDX-License-Identifier: MIT */
void main(float4 uv : TEXCOORD0, float4 mult : TEXCOORD1,
          float4 params : TEXCOORD2, float4 add : TEXCOORD5,
          uniform sampler2D tex0 : TEXUNIT0, out float4 color : COLOR)
{
    float focal = params.x;
    float2 p = uv.xy * 2.0 - 1.0;
    float2 delta = float2(focal, 0.0) - p;
    float distance = length(delta);
    float2 direction = delta / max(distance, 0.00001);
    float root = sqrt(max(1.0 - focal * focal * direction.y * direction.y, 0.00001));
    float t = distance / max(root + focal * direction.x, 0.00001);
    color = saturate(tex2D(tex0, float2(t, 0.5)) * mult + add);
}

