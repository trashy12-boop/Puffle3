@@ -0,0 +1,43 @@
+//! Optional, single-thread diagnostic accounting. Disabled in normal builds.
+//! VM time includes builtins and collision time; those columns overlap.
+use std::cell::RefCell;
+unsafe extern "C" {fn rp_profile_clock_us()->u64;}
+fn now_us()->u64 {unsafe{rp_profile_clock_us()}}
+#[repr(C)]
+#[derive(Clone,Copy,Default,Debug)]
+pub struct Stats {
+ pub vm_us:u64,pub collision_us:u64,pub gc_us:u64,
+ pub opcodes:u64,pub gets:u64,pub sets:u64,pub calls:u64,
+ pub hit_tests:u64,pub frames:u64,pub vm_entries:u64,
+}
+#[derive(Clone,Copy)] pub enum Kind {Vm=0,Collision=1,Gc=2}
+#[derive(Default)] struct State {stats:Stats,depth:[u32;3]}
+thread_local! {static STATE:RefCell<State>=RefCell::new(State::default());}
+pub struct Scope {kind:Kind,start:Option<u64>}
+impl Scope {
+ pub fn new(kind:Kind)->Self {
+  let outer=STATE.with(|s|{let mut s=s.borrow_mut();let i=kind as usize;let outer=s.depth[i]==0;s.depth[i]+=1;
+   match kind {Kind::Vm=>s.stats.vm_entries+=1,Kind::Collision=>s.stats.hit_tests+=1,Kind::Gc=>{}};outer});
+  Self{kind,start:outer.then(now_us)}
+ }
+}
+impl Drop for Scope {
+ fn drop(&mut self){
+  let us=self.start.map(|s|now_us().saturating_sub(s));
+  STATE.with(|s|{let mut s=s.borrow_mut();s.depth[self.kind as usize]-=1;
+   if let Some(us)=us {match self.kind {Kind::Vm=>s.stats.vm_us+=us,Kind::Collision=>s.stats.collision_us+=us,Kind::Gc=>s.stats.gc_us+=us}}});
+ }
+}
+pub fn opcode(){STATE.with(|s|s.borrow_mut().stats.opcodes+=1)}
+pub fn get(){STATE.with(|s|s.borrow_mut().stats.gets+=1)}
+pub fn set(){STATE.with(|s|s.borrow_mut().stats.sets+=1)}
+pub fn call(){STATE.with(|s|s.borrow_mut().stats.calls+=1)}
+pub fn frame(){STATE.with(|s|s.borrow_mut().stats.frames+=1)}
+pub fn take()->Stats{STATE.with(|s|{let mut s=s.borrow_mut();debug_assert_eq!(s.depth,[0;3]);std::mem::take(&mut s.stats)})}
+#[cfg(test)]mod tests {
+ use super::*;
+ #[test]fn nested_scopes_count_calls_without_double_counting_time(){
+  take();{let _a=Scope::new(Kind::Vm);let _b=Scope::new(Kind::Vm);opcode();get();set();call();frame();}
+  let s=take();assert_eq!(s.vm_entries,2);assert_eq!((s.opcodes,s.gets,s.sets,s.calls,s.frames),(1,1,1,1,1));assert_eq!(take().opcodes,0);
+ }
+}
