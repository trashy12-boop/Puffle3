+fn index_text(index:i32, buffer:&mut [u8;11])->&WStr {
+    let mut remaining=index.unsigned_abs();let mut pos=buffer.len();
+    loop {pos-=1;buffer[pos]=b'0'+(remaining%10)as u8;remaining/=10;if remaining==0{break;}}
