+    /// custom attributes, virtual properties and watchers use the generic path.
+    fn dense_array_values(self, activation: &Activation<'_, 'gc>, length: i32) -> Option<Vec<Value<'gc>>> {
+        if !(0..=16384).contains(&length) { return None; }
+        let data = self.0.borrow();
+        if !matches!(&data.native, NativeObject::Array(_)) || data.watchers.len() != 0 || length as usize > data.properties.len() { return None; }
+        let length_property = data.properties.get(istr!("length"), activation.is_case_sensitive())?;
+        if length_property.is_virtual() || !length_property.is_overwritable() || !matches!(length_property.data(), Value::Number(n) if n == length as f64) { return None; }
+        let mut values = Vec::new();
+        if values.try_reserve_exact(length as usize).is_err() { return None; }
+        values.resize(length as usize, Value::Undefined);
+        let mut count = 0;
+        for (name, property) in data.properties.iter() {
+            if let Some(index) = canonical_index(name.as_wstr()) {
+                if index >= values.len() || property.is_virtual() || !property.attributes().is_empty() { return None; }
+                values[index] = property.data();count += 1;
+            }
+        }
+        (count == values.len()).then_some(values)
+    }
