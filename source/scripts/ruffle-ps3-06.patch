+fn canonical_index(name:&WStr)->Option<usize>{
+    if name.is_empty() || (name.len()>1 && name.at(0)==b'0' as u16){return None;}
+    let mut index=0usize;
+    for c in name.iter(){if !(b'0' as u16..=b'9' as u16).contains(&c){return None;}index=index.checked_mul(10)?.checked_add((c-b'0' as u16)as usize)?;}
+    Some(index)
+}
